{
  "expo": {
    "name": "GTA 6 Guidebook",
    "slug": "gta6-guidebook",
    "owner": "serhatsamigolus-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gta6guidebook",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.serhatsamigolu.gtasixguidebook",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0B14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.serhatsamigolu.gtasixguidebook"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0B14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can add photos to your map notes.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can add them to your map notes.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9734141534745644~3695502657",
          "iosAppId": "ca-app-pub-9734141534745644~4569600622",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This identifier will be used to show you more relevant ads."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ],
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "32b51b03-c4ac-44a5-9fc0-e033fa3a6ab3"
      }
    }
  }
}
